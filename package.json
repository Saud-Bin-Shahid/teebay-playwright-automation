{
  "name": "teebay-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright (JavaScript) UI automation for the Teebay-Buggy application, using the Page Object Model",
  "private": true,
    "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:file": "playwright test",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.15.0",
    "dotenv": "^16.4.5"
  }
}
